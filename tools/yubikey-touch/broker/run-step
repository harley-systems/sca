#!/bin/bash
################################################################################
# entrypoint of the fixture broker's test image: start pcscd, then run one step
#
#   run-step test PATH    run /src/PATH with bash

# the container has no polkit: without --disable-polkit pcscd denies every client
pcscd --disable-polkit || { echo "run-step: pcscd did not start" >&2; exit 125; }
for _ in $(seq 50); do
  [ -S /run/pcscd/pcscd.comm ] && break
  sleep 0.1
done

case "${1:-}" in
  test)
    [ -n "${2:-}" ] || { echo "run-step: test needs a path" >&2; exit 125; }
    exec bash "/src/$2"
    ;;
  *)
    echo "usage: run-step test PATH" >&2
    exit 125
    ;;
esac
