# YubiKey fixture broker config: ~/.config/sca/yubikey-fixture.conf
#
# The broker only acts for the keys listed here, found by the serial they
# publish over USB. Any other YubiKey, including your own, is never opened or
# shown to a test.

[slots]
# slot (4 or 5, the touch fixture's names) = test-key serial (ykman list --serials)
4 = 38263298
# 5 =

[broker]
# repository = https://github.com/harley-systems/sca.git
# image = sca-yubikey-fixture
# max_timeout = 1800
